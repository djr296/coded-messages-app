{
  "name": "coded-messages-app",
  "version": "2.5.0",
  "description": "Windows desktop obfuscated chat app",
  "author": "Coded Messages",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "main.js",
  "scripts": {
    "build:preload": "node scripts/build-preload.cjs",
    "prestart": "npm run build:preload",
    "start": "electron .",
    "server:start": "node server/start.js",
    "test": "node --test server/index.test.js tests/security.test.js",
    "test:rules": "node scripts/run-rules-tests.cjs",
    "pack": "npm run build:preload && electron-builder --dir",
    "dist:win": "npm run build:preload && electron-builder --win nsis"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "sql.js": "^1.13.0"
  },
  "build": {
    "beforePack": "scripts/before-pack.cjs",
    "appId": "com.codedmessages.app",
    "productName": "Coded Messages",
    "artifactName": "Coded-Messages-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "main.js",
      "generated/preload.cjs",
      "package.json",
      "renderer/**/*",
      "shared/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeaderIcon": "assets/app-icon.ico"
    }
  }
}
